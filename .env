# MongoDB Connection URI
# Get this from:
# 1. MongoDB Atlas (free tier): https://www.mongodb.com/cloud/atlas
# 2. MongoDB Local: mongodb://localhost:27017/echina
# 3. MongoDB Cloud URI format: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/echina

MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/echina

# API Configuration
VITE_API_URL=http://localhost:3001

# Google OAuth (Optional - for social login)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Server Port
PORT=3001
