# ⚠️  LOCAL DEVELOPMENT ONLY - Do not commit real credentials!
# For production, set these in Netlify Dashboard: Settings > Build & Deploy > Environment

# MongoDB Connection (required for local development)
# Get from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://cristosrex22_db_user:Sijuade27@echina.uumsajp.mongodb.net/?appName=Echina

# API Configuration
# Leave empty to use relative paths (works in both dev and production)
# VITE_API_URL is not set - frontend will use /api/* which:
# - In dev: Vite proxy routes to http://localhost:3001
# - In prod: Express serves from same server

PORT=3001
NODE_ENV=development

# Google OAuth (optional - for social login)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Stripe (optional - for payments)
# VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key
