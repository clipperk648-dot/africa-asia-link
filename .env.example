# MongoDB Connection String (Required for authentication and database operations)
# Get one free from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/echina

# Node Environment
NODE_ENV=development

# Server Port (used when running npm run dev:server locally)
PORT=3001

# Stripe (optional - for payments)
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key

# SendGrid (optional - for emails)
SENDGRID_API_KEY=your_sendgrid_api_key

# Analytics (optional)
VITE_ENABLE_ANALYTICS=false
